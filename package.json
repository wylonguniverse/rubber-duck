{
  "name": "rubber-duck",
  "displayName": "Rubber Duck Debugger",
  "description": "Резиновая утка в боковой панели: не решает проблему за вас, а задаёт вопросы, пока вы сами не найдёте ответ.",
  "version": "0.1.3",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rubberDuck",
          "title": "Резиновая утка",
          "icon": "media/duck-icon.svg"
        }
      ]
    },
    "views": {
      "rubberDuck": [
        {
          "type": "webview",
          "id": "rubberDuck.chatView",
          "name": "Чат с уткой"
        }
      ]
    },
    "commands": [
      {
        "command": "rubberDuck.start",
        "title": "Начать сессию",
        "category": "Утка"
      },
      {
        "command": "rubberDuck.explainSelection",
        "title": "Объяснить утке выделенный код",
        "category": "Утка"
      },
      {
        "command": "rubberDuck.askDiagnostics",
        "title": "Спросить про ошибки в файле",
        "category": "Утка"
      },
      {
        "command": "rubberDuck.reset",
        "title": "Новая сессия",
        "category": "Утка",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rubberDuck.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "rubberDuck.reset",
          "when": "view == rubberDuck.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Резиновая утка",
      "properties": {
        "rubberDuck.duckName": {
          "type": "string",
          "default": "Кряк",
          "description": "Как зовут вашу утку (используется в приветствии)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
